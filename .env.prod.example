# Values for docker-compose.prod.yml. Copy to .env.prod (gitignored), fill in
# every line, and keep the file readable only by the operator account.
# Generate secrets with: openssl rand -hex 32

# Public host name the officers use; Caddy serves https://$DOMAIN
DOMAIN=tolkcheck.example.org

# Database owner — used only by the one-off `migrate` service
POSTGRES_USER=tolkcheck_owner
POSTGRES_PASSWORD=

# Least-privilege role the API and worker connect as
APP_DB_PASSWORD=

REDIS_PASSWORD=
SECRET_KEY=

# Model downloads (pyannote licence must be accepted for this account)
HF_TOKEN=

# Claude feedback step. Without a key, sessions are scored but then end in
# FAILED / LLM_ERROR. Note: this sends transcripts to Anthropic (outside the
# EU) — see DEPLOYMENT-SECURITY.md before enabling it.
ANTHROPIC_API_KEY=

RETENTION_DAYS=90
